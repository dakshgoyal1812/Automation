# App Configuration
PORT=8000

# LLM APIs (Configure all, or choose subset; system auto-falls back)
# You can provide a single Groq key, or multiple keys separated by commas for auto-rotation on quota depletion
GROQ_API_KEY=gsk_key1,gsk_key2,gsk_key3
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# Google Apps Script Gmail Bridge
# A custom random secret token. Make sure it matches what you set in Apps Script.
GMAIL_BRIDGE_SECRET=your_gmail_bridge_secret_here

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord Client Bot Integration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# WhatsApp Cloud API Integration
WHATSAPP_TOKEN=your_whatsapp_temporary_or_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=a_custom_token_used_when_registering_webhook_in_meta_dashboard

# Spotify Integration
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/spotify/callback
